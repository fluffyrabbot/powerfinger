(footprint "IR_Emitter_Lead_Pads" (layer "B.Cu") (tags "CERN-OHL-S-2.0") (descr "Off-board IR emitter wire terminations, pin 1 anode, pin 2 cathode; external carrier sets alignment")
    (fp_rect (start -2.05 -0.95) (end 2.05 0.95) (stroke (width 0.05) (type solid)) (fill none) (layer "B.CrtYd"))
    (pad "1" thru_hole rect (at -1.27 0) (size 1.5 1.5) (drill 0.8) (layers "*.Cu" "*.Mask"))
    (pad "2" thru_hole circle (at 1.27 0) (size 1.5 1.5) (drill 0.8) (layers "*.Cu" "*.Mask"))
  )
